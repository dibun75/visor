{
  "name": "visor-hud",
  "displayName": "V.I.S.O.R. HUD",
  "publisher": "dibun75",
  "description": "Optional 3D HUD for the local V.I.S.O.R. context engine. Shows the dependency graph, indexed node count, drift, and agent focus. The CLI and MCP server work without it.",
  "version": "1.4.2",
  "icon": "assets/hero.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dibun75/visor"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "mcp",
    "codex",
    "claude-code",
    "ai",
    "codebase",
    "dependency-graph",
    "code-visualization",
    "context-engineering",
    "local-first",
    "3d-visualization"
  ],
  "galleryBanner": {
    "color": "#070b14",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "visor.startHUD",
        "title": "Start V.I.S.O.R. HUD"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visor-explorer",
          "title": "V.I.S.O.R.",
          "icon": "assets/visor-icon.svg"
        }
      ]
    },
    "views": {
      "visor-explorer": [
        {
          "type": "webview",
          "id": "visor-sidebar",
          "name": "Telemetry"
        }
      ]
    },
    "configuration": {
      "title": "V.I.S.O.R. Config",
      "properties": {
        "visor.serverPath": {
          "type": "string",
          "default": "",
          "description": "Optional absolute path to server.py or a visor-mcp executable. Empty uses a local source checkout when present, then falls back to uv tool run visor-mcp."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "rm -rf hud-dist && cp -r ../hud/dist ./hud-dist && npm run check-types && node esbuild.js",
    "check-types": "tsc --noEmit -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "1.80.x",
    "esbuild": "^0.28.2",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

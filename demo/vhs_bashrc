# Shell startup for demo/terminal_demo.tape.
# Filters absolute home paths and the local workspace hash out of real
# V.I.S.O.R. output. It does not replace command results.
#
# VISOR_DEMO_ROOT is optional. Set it when the checkout contains .venv or
# node_modules and you want the recorded commands to run in a clean tree.

PS1='visor $ '
if [[ -n "${VISOR_DEMO_ROOT:-}" ]]; then
  cd "$VISOR_DEMO_ROOT" || exit 1
fi
_visor_demo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

sanitize() {
  local workspace_name
  workspace_name=$(basename "$_visor_demo_root")
  sed -E \
    -e "s#${HOME}#~#g" \
    -e "s#${_visor_demo_root}#.#g" \
    -e "s#${USER}#user#g" \
    -e "s#workspaces/[0-9a-f]{12}#workspaces/<hash>#g" \
    -e "s#hash=[0-9a-f]{12}#hash=<hash>#g" \
    -e "s#workspace=${workspace_name}#workspace=visor#g"
}

uv() {
  if [[ "${1-}" == "run" && "${2-}" == "visor" ]]; then
    shift 2
    if [[ -n "${VISOR_UV_PROJECT:-}" ]]; then
      command uv run --project "$VISOR_UV_PROJECT" visor "$@" 2>&1 | sanitize
    else
      command uv run visor "$@" 2>&1 | sanitize
    fi
    return "${PIPESTATUS[0]}"
  fi
  command uv "$@"
}
